# AWS Configuration
AWS_REGION=us-east-1

# Bedrock Models
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=amazon.nova-pro-v1:0

# Knowledge Base (populated by Terraform from compass-knowledge-hub outputs)
KNOWLEDGE_BASE_ID=

# Bedrock Guardrails (optional - no-op when GUARDRAIL_ID is unset)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Cognito Auth (optional - all routes open when unset)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REGION=

# AgentCore
AGENTCORE_RUNTIME_ARN=

# DynamoDB Tables (chat session storage)
CHAT_SESSIONS_TABLE_NAME=
CHAT_CONVERSATIONS_TABLE_NAME=
CHAT_MONTHLY_USAGE_TABLE_NAME=
MONTHLY_TOKEN_LIMIT=200000
FEEDBACK_TABLE_NAME=

# Legacy OpenSearch fields (not used with Bedrock KB)
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=
